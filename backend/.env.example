# Copy this file to .env (same folder) and fill it in.
# .env is in .gitignore — NEVER commit it, and never put these values in the extension.

# "mock"       = fake keyword-based results, no Databricks needed (default)
# "databricks" = real LLM analysis through a Databricks model serving endpoint
ANALYSIS_MODE=mock

# Port the backend listens on (the extension expects 8787).
PORT=8787

# --- Only needed when ANALYSIS_MODE=databricks ---------------------------------
# Your workspace URL, no trailing slash. Example: https://dbc-1234abcd-5678.cloud.databricks.com
DATABRICKS_HOST=
# A personal access token from your Databricks user settings.
DATABRICKS_TOKEN=
# Name of a chat model serving endpoint, as shown on the workspace's "Serving" page.
# Example (check your own workspace; names vary): databricks-meta-llama-3-3-70b-instruct
DATABRICKS_SERVING_ENDPOINT=

# --- Optional -----------------------------------------------------------------
# If set, the backend only accepts /api/analyze calls from this extension ID
# (find it on chrome://extensions). Leave empty during early development.
ALLOWED_EXTENSION_ID=
